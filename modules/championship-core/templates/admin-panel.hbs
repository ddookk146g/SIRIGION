<section class="championship-core">
  <div class="toolbar">
    <button type="button" data-action="refresh">
      <i class="fas fa-rotate"></i> Обновить
    </button>

    <button type="button" data-action="open-turn">
      <i class="fas fa-lock-open"></i> Открыть ход
    </button>

    <button type="button" data-action="close-turn">
      <i class="fas fa-lock"></i> Закрыть ход
    </button>
  </div>

  <p>
    Текущий ход: <strong>{{currentTurn}}</strong> / {{maxTurns}}
    {{#if isTurnOpen}}
      <span class="status-open">(ОТКРЫТ)</span>
    {{else}}
      <span class="status-closed">(ЗАКРЫТ)</span>
    {{/if}}
  </p>

  <table>
    <thead>
      <tr>
        <th>Команда</th>
        <th>Статус</th>
        <th>Предприятия</th>
        <th>Участки</th>
        <th>Инвестиции</th>
        <th>Действия</th>
      </tr>
    </thead>

    <tbody>
      {{#each teams}}
      <tr>
        <td>{{teamName}}</td>
        <td>{{statusLabel}}</td>
        <td>{{enterpriseCount}}</td>
        <td>{{plotCount}}</td>
        <td>{{availableInvestmentPoints}} / {{totalInvestmentPoints}}</td>
        <td>
          <button type="button" data-action="open-company" data-team-id="{{teamId}}">
            <i class="fas fa-book"></i>
          </button>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</section>
